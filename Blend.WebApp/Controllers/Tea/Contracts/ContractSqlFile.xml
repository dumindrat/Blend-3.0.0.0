      trn_ContractHeaderGet
    </procedure>
    <procedure id="GetOpenContracts" parameterMap="get-opencontracts-params"  resultMap="get-opencontracts-result">
      trn_ContractOpenGet
    </procedure>
    <procedure id="GetBlendNoByContractAndStandard" parameterMap="get-blendnobycon-params"  resultMap="get-blendnobycon-result">
      trn_BlendNoGetByContractAndStandard
    </procedure>
  </statements>
  <parameterMaps>
    
    <parameterMap id="get-contractsdet-params" class ="Blend.BuisnessEntities.Contract.BuyerContract">
      <parameter property="ContractId" direction  ="Input"/>
    </parameterMap>
    <parameterMap id="get-availablestandard-params" class ="Blend.BuisnessEntities.Standard.TeaStandardForContract">
