    </parameterMap>
    <parameterMap id="get-availablestandardsearch-params" class ="Blend.BuisnessEntities.Standard.TeaStandardForContract">
      <parameter property="ContractId" direction  ="Input" />
      <parameter property="StandardName" direction  ="Input" />
      <parameter property="CompanyId" direction  ="Input" />
    </parameterMap>
    <parameterMap id="get-allcontracts-params">
      <parameter property="ContractName" direction  ="Input" />
      <parameter property="CompanyId" direction  ="Input" />
    </parameterMap>
    <parameterMap id="get-opencontracts-params">
    </parameterMap>
    <parameterMap id="get-blendnobycon-params">
      <parameter property="ContractId" direction  ="Input" />
      <parameter property="StandardId" direction  ="Input" />
    </parameterMap>
  </parameterMaps>

  <resultMaps>
    <resultMap id="get-blendnobycon-result" class="Blend.BuisnessEntities.Contract.BlendNoByCon">
      <result property="BlendNo" column="BlendNo" dbType="Varchar"/>
      <result property="ClosedStatus" column="ClosedStatus" dbType="Varchar"/>
    </resultMap>
    <resultMap id="get-contractsdet-result" class="Blend.BuisnessEntities.Contract.BuyerContractDetail">
      <result property="ContractId" column="ContractId" dbType="Int"/>
      <result property="StandardId" column="StandardId" dbType="Int"/>
      <result property="StandardName" column="StandardName" dbType="Varchar"/>
      <result property="OrderQty" column="OrderQty" dbType="Varchar"/>
      <result property="RowVersion" column="RowVersion" dbType="VarBinary"/>
    </resultMap>
    <resultMap id="get-allcontracts-result" class="Blend.BuisnessEntities.Contract.BuyerContract">
      <result property="ContractId" column="ContractId" dbType="Int"/>
      <result property="ContractName" column="ContractName" dbType="Varchar"/>
      <result property="BuyerId" column="BuyerId" dbType="Int"/>
