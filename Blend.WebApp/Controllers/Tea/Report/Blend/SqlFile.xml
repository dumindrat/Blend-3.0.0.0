      <result property="ClosedRate" column="ClosedRate" dbType="Decimal"/>
      <result property="ExportQty" column="ExportQty" dbType="Decimal"/>
      <result property="BB" column="BB" dbType="Decimal"/>
      <result property="BG" column="BG" dbType="Decimal"/>
      <result property="BL" column="BL" dbType="Decimal"/>
      <result property="IsClosed" column="IsClosed" dbType="Int"/>
      <result property="TrialVersion" column="TrialVersion" dbType="Varchar"/>

    </resultMap>

    <resultMap id="get-blndcanister-result" class="Blend.BuisnessEntities.Report.BlendCanister">
      <result property="BlendNo" column="BlendNo" dbType="Varchar"/>
      <result property="StockQty" column="StockQty" dbType="Varchar"/>
