      <result property="ExportQty" column="ExportQty" dbType="Decimal"/>
      <result property="LineQty" column="LineQty" dbType="Decimal"/>
      <result property="Rate" column="Rate" dbType="Decimal"/>
      <result property="CloseStatus" column="CloseStatus" dbType="Varchar"/>
      <result property="IsClosed" column="IsClosed" dbType="Int"/>
      <result property="IsCancelRequest" column="IsCancelRequest" dbType="Int"/>
      <result property="RowVersion" column="RowVersion" dbType="VarBinary"/>
      
    </resultMap>
    <resultMap id="get-blendcloseinfo-result" class="Blend.BuisnessEntities.BlendClose.BlendCloseDto">
      <result property="LineQty" column="LineQty" dbType="Decimal"/>
      <result property="ExportQty" column="ExportQty" dbType="Decimal"/>
