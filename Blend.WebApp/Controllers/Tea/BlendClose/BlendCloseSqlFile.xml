    <procedure id="GetBlendCloseInfo" parameterMap="get-blendcloseinfo-params"  resultMap="get-blendcloseinfo-result">
      trn_BlendCategorizeGetByBlendId
    </procedure>
  </statements>

  <parameterMaps>
    <parameterMap id="get-blendclose-params">
      <parameter property="BlendNo" direction  ="Input" />
