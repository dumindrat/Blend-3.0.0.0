@page "/"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "PasswordChangeComplete")]

<PageTitle>Blend Operations</PageTitle>

<AuthorizeView>
    <Authorized Context="authState">
        <div class="page-heading">
            <div>
                <span class="eyebrow">BLEND OPERATIONS</span>
                <h1>Welcome, @authState.User.FindFirst("blend:display-name")?.Value</h1>
                <p class="muted">Signed in as @authState.User.Identity?.Name</p>
            </div>
        </div>
        <section class="panel">
            <div class="panel-kicker">ACCOUNT</div>
            <h2>You're signed in</h2>
            <p>Authentication and role management are enabled. Blend data operations will be restored after the legacy data API is migrated to this authentication system.</p>
            <p><strong>Your roles:</strong> @string.Join(", ", authState.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(claim => claim.Value))</p>
            <div class="heading-actions">
                <a class="button button-quiet" href="/Account/ChangePassword">Change password</a>
                <AuthorizeView Roles="Admin">
                    <Authorized><a class="button button-primary" href="/Admin/Users">Manage users</a></Authorized>
                </AuthorizeView>
                <a class="button button-quiet" href="/Account/Logout">Sign out</a>
            </div>
        </section>
    </Authorized>
</AuthorizeView>
