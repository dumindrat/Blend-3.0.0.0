@inherits LayoutComponentBase
@using System.Security.Claims
@using Blend.BlazorApp.Authentication
@using Microsoft.EntityFrameworkCore
@inject BlendIdentityDbContext Database
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-frame">
    <aside class="sidebar">
        <a class="brand" href="/">
            <span class="brand-mark">B</span>
            <span><strong>blend</strong><small>Operations suite</small></span>
        </a>
        <div class="nav-caption">WORKSPACE</div>
        <nav class="side-nav" aria-label="Main navigation">
            <a class="nav-link active" href="/"><span class="nav-icon">◫</span>Overview</a>
            <AuthorizeView>
                <Authorized>
                    @foreach (var group in MenuGroups)
                    {
                        <div class="nav-caption menu-group-caption">@group.Name</div>
                        @foreach (var item in group.Items)
                        {
                            <a class="nav-link" href="@item.Path"><span class="nav-icon">•</span>@item.Name</a>
                        }
                    }
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="ManageUsers">
                <Authorized><a class="nav-link" href="/Admin/Users"><span class="nav-icon">▤</span>User administration</a></Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a class="nav-link" href="/Admin/Roles"><span class="nav-icon">⚙</span>Role management</a>
                    <a class="nav-link" href="/Admin/MenuItems"><span class="nav-icon">☷</span>Menu items</a>
                </Authorized>
            </AuthorizeView>
        </nav>
        <div class="sidebar-bottom">
            <div class="nav-caption">ACCOUNT</div>
            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="connection-state"><span class="status-dot"></span> Signed in</div>
                    <div class="sidebar-user"><span class="avatar">@Initials(authState.User.Identity?.Name)</span><span><strong>@authState.User.Identity?.Name</strong><small>@string.Join(", ", authState.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(claim => claim.Value))</small></span></div>
                    <a class="nav-link" href="/Account/ChangePassword">Change password</a>
                    <a class="nav-link" href="/Account/Logout">Sign out</a>
                </Authorized>
            </AuthorizeView>
            <div class="sidebar-version">Modern client · .NET 10</div>
        </div>
    </aside>
    <div class="main-shell">
        <header class="topbar">
            <div><span class="breadcrumb-muted">Blend</span><span class="breadcrumb-divider">/</span><strong>Workspace</strong></div>
            <div class="topbar-right"><span class="live-indicator"></span> Live operations</div>
        </header>
        <main class="content-area">@Body</main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button class="dismiss" aria-label="Dismiss">×</button>
</div>

@code {
    private IReadOnlyList<MenuGroup> MenuGroups { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var menuQuery = Database.MenuItems.AsNoTracking();
        if (!user.IsInRole(BlendRoles.Admin))
        {
            var roleNames = user.FindAll(ClaimTypes.Role)
                .Select(claim => claim.Value)
                .Distinct(StringComparer.Ordinal)
                .ToArray();
            if (roleNames.Length == 0)
            {
                return;
            }

            menuQuery = menuQuery.Where(item => Database.MenuItemRoles.Any(assignment =>
                assignment.MenuItemId == item.Id && roleNames.Contains(assignment.Role.Name!)));
        }

        var menuItems = await menuQuery
            .OrderBy(item => item.SortOrder)
            .ThenBy(item => item.Name)
            .ToListAsync();

        MenuGroups = menuItems
            .GroupBy(item => item.GroupName, StringComparer.OrdinalIgnoreCase)
            .Select(group => new MenuGroup(group.Key, group.ToArray()))
            .ToArray();
    }

    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "B" : name[..1].ToUpperInvariant();

    private sealed record MenuGroup(string Name, IReadOnlyList<BlendMenuItem> Items);
}
