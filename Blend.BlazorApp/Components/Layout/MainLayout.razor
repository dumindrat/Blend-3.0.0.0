@inherits LayoutComponentBase
@using System.Security.Claims
@using Blend.BlazorApp.Authentication
@using Microsoft.EntityFrameworkCore
@inject BlendIdentityDbContext Database
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-frame">
    <aside class="sidebar">
        <a class="brand" href="/">
            <span class="brand-mark">B</span>
            <span><strong>blend</strong><small>Operations suite</small></span>
        </a>
        <div class="nav-caption">WORKSPACE</div>
        <nav class="side-nav" aria-label="Main navigation">
            <a class="nav-link active" href="/"><span class="nav-icon">◫</span>Overview</a>
            <AuthorizeView>
                <Authorized>
                    @foreach (var group in MenuGroups)
                    {
                        <div class="module-nav-group" data-module-group data-module-id="@group.ModuleId">
                            <div class="nav-caption menu-group-caption">@group.Name</div>
                            @foreach (var item in group.Items)
                            {
                                <a class="nav-link" data-module-id="@group.ModuleId" href="@item.Path"><span class="nav-icon">•</span>@item.Name</a>
                            }
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="ManageUsers">
                <Authorized><a class="nav-link" href="/Admin/Users"><span class="nav-icon">▤</span>User administration</a></Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="ManageRoles">
                <Authorized><a class="nav-link" href="/Admin/Roles"><span class="nav-icon">⚙</span>Role management</a></Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="ManageMenuItems">
                <Authorized><a class="nav-link" href="/Admin/MenuItems"><span class="nav-icon">☷</span>Menu items</a></Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Admin">
                <Authorized><a class="nav-link" href="/Admin/Companies"><span class="nav-icon">▦</span>Companies</a></Authorized>
            </AuthorizeView>
        </nav>
        <div class="sidebar-bottom">
            <div class="nav-caption">ACCOUNT</div>
            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="connection-state"><span class="status-dot"></span> Signed in</div>
                    <div class="sidebar-user"><span class="avatar">@Initials(authState.User.Identity?.Name)</span><span><strong>@authState.User.Identity?.Name</strong><small>@string.Join(", ", authState.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(claim => claim.Value))</small></span></div>
                    <a class="nav-link" href="/Account/ChangePassword">Change password</a>
                    <a class="nav-link" href="/Account/Logout">Sign out</a>
                </Authorized>
            </AuthorizeView>
            <div class="sidebar-version">Modern client · .NET 10</div>
        </div>
    </aside>
    <div class="main-shell">
        <header class="topbar">
            <div><span class="breadcrumb-muted">Blend</span><span class="breadcrumb-divider">/</span><strong>Workspace</strong></div>
            <div class="topbar-right">
                @if (Modules.Count > 0)
                {
                    <label class="module-switcher"><span>MODULE</span><select aria-label="Select module" data-module-selector data-module-storage-key="@ModuleStorageKey">@foreach (var module in Modules) { <option value="@module.Id">@(module.Company is null ? module.Name : $"{module.Company.Name} · {module.Name}")</option> }</select></label>
                }
                <span class="live-indicator"></span> Live operations
            </div>
        </header>
        <main class="content-area">@Body</main>
        <dialog id="module-switch-confirmation" class="modal-card module-confirmation-dialog" aria-labelledby="module-switch-heading" aria-describedby="module-switch-copy">
            <div class="modal-heading">
                <div>
                    <div class="panel-kicker">CHANGE MODULE</div>
                    <h2 id="module-switch-heading">Switch workspace?</h2>
                </div>
            </div>
            <p id="module-switch-copy" class="module-confirmation-copy">Are you sure you want to move to the <strong id="module-switch-destination"></strong> module?</p>
            <div class="modal-actions">
                <button class="button button-quiet" type="button" data-module-switch-cancel>Cancel</button>
                <button class="button button-primary" type="button" data-module-switch-confirm>Switch module</button>
            </div>
        </dialog>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button class="dismiss" aria-label="Dismiss">×</button>
</div>

@code {
    private IReadOnlyList<MenuGroup> MenuGroups { get; set; } = [];
    private IReadOnlyList<BlendModule> Modules { get; set; } = [];
    private string ModuleStorageKey { get; set; } = "blend-active-module-admin";

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var isPlatformAdmin = user.IsInRole(BlendRoles.Admin);
        if (isPlatformAdmin)
        {
            Modules = await Database.Modules.AsNoTracking().Include(module => module.Company)
                .OrderBy(module => module.Company.Name).ThenBy(module => module.Name).ToListAsync();
        }
        else if (Guid.TryParse(user.FindFirst(BlendClaims.CompanyId)?.Value, out var moduleCompanyId))
        {
            ModuleStorageKey = $"blend-active-module-{moduleCompanyId:D}";
            Modules = await Database.Modules.AsNoTracking().Where(module => module.CompanyId == moduleCompanyId)
                .OrderBy(module => module.Name).ToListAsync();
        }

        var menuQuery = Database.MenuItems.AsNoTracking();
        if (!isPlatformAdmin)
        {
            if (!Guid.TryParse(user.FindFirst(BlendClaims.CompanyId)?.Value, out var companyId))
            {
                return;
            }

            var roleIds = user.FindAll(BlendClaims.RoleId)
                .Select(claim => claim.Value)
                .Distinct(StringComparer.Ordinal)
                .ToArray();
            menuQuery = menuQuery.Where(item => item.CompanyId == companyId
                && roleIds.Length > 0
                && Database.MenuItemRoles.Any(assignment =>
                    assignment.MenuItemId == item.Id
                    && roleIds.Contains(assignment.RoleId)
                    && assignment.Role.CompanyId == companyId));
        }

        var menuItems = await menuQuery
            .OrderBy(item => item.SortOrder)
            .ThenBy(item => item.Name)
            .ToListAsync();

        MenuGroups = menuItems
            .GroupBy(item => item.ModuleId)
            .SelectMany(moduleGroup => moduleGroup
                .GroupBy(item => item.GroupName, StringComparer.OrdinalIgnoreCase)
                .Select(group => new MenuGroup(moduleGroup.Key, group.Key, group.ToArray())))
            .ToArray();
    }

    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "B" : name[..1].ToUpperInvariant();

    private sealed record MenuGroup(int ModuleId, string Name, IReadOnlyList<BlendMenuItem> Items);
}
