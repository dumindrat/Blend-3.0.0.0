@page
@model ChangePasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Change password · Blend Operations</title>
    <link rel="stylesheet" href="~/app.css" />
    <link rel="stylesheet" href="~/workspace.css" />
</head>
<body>
    <main class="content-area">
        <section class="panel login-card">
            <div class="panel-kicker">ACCOUNT SECURITY</div>
            <h1>Set a new password</h1>
            <p>Your temporary password must be replaced before continuing.</p>
            <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
            <form method="post">
                <label asp-for="Input.CurrentPassword">Current temporary password</label>
                <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" required />
                <label asp-for="Input.NewPassword">New password</label>
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" required />
                <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" required />
                <button class="button button-primary button-wide" type="submit">Change password</button>
            </form>
        </section>
    </main>
</body>
</html>
