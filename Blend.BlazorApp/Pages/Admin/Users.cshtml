@page
@model UsersModel
@{
    Layout = "_Layout";
}
<main class="content-area">
        <section class="panel">
            <div class="panel-kicker">ADMINISTRATION</div>
            <h1>Users</h1>
            <p><a class="button button-quiet" href="/" onclick="if (document.referrer && new URL(document.referrer).origin === location.origin) { history.back(); return false; }">&larr; Back</a></p>
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
                <p><strong>Temporary password:</strong> <code>@Model.TemporaryPassword</code></p>
            }
            @if (User.IsInRole(BlendRoles.Admin))
            {
                <form method="get" class="company-selector">
                    <label for="CompanyId">Company</label>
                    <select id="CompanyId" name="CompanyId" class="form-control" onchange="this.form.submit()">
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.Id" selected="@(Model.CompanyId == company.Id.ToString("D") ? "selected" : null)">@company.Name</option>
                        }
                    </select>
                </form>
            }
            <div class="user-list-heading">
                <div>
                    <h2>Accounts</h2>
                    <p>Manage user access for @(Model.Companies.FirstOrDefault(company => company.Id.ToString("D") == Model.CompanyId)?.Name ?? "your company").</p>
                </div>
                <button class="button button-primary" type="button" onclick="document.getElementById('create-user-dialog').showModal()" disabled="@(Model.CompanyId is null || Model.AvailableRoles.Count == 0)">Create user</button>
            </div>
            @if (!Model.ShowCreateDialog && Model.ShowEditUserId is null)
            {
                <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
            }
            <dialog id="create-user-dialog" class="modal-card modal-wide company-create-dialog" aria-labelledby="create-user-heading">
                <div class="modal-heading">
                    <div>
                        <div class="panel-kicker">NEW ACCOUNT</div>
                        <h2 id="create-user-heading">Create user</h2>
                        <p class="muted">A temporary password will be generated. The user must change it at first sign-in.</p>
                    </div>
                    <button class="icon-button" type="button" aria-label="Close" onclick="document.getElementById('create-user-dialog').close()">&times;</button>
                </div>
                @if (Model.ShowCreateDialog)
                {
                    <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
                }
                <form method="post" class="company-create-form">
                    <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                    <div class="company-modal-field"><label asp-for="Input.UserName">Username</label><input asp-for="Input.UserName" class="form-control" autocomplete="off" required /></div>
                    <div class="company-modal-field"><label asp-for="Input.DisplayName">Display name</label><input asp-for="Input.DisplayName" class="form-control" required /></div>
                    <div class="company-modal-field"><label asp-for="Input.Email">Email (optional)</label><input asp-for="Input.Email" class="form-control" autocomplete="email" /></div>
                    <div class="company-modal-field"><label asp-for="Input.RoleId">Role</label>
                        <select asp-for="Input.RoleId" class="form-control" required>
                            <option value="">Select a role</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role.Id">@role.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="modal-actions company-modal-actions">
                        <button class="button button-quiet" type="button" onclick="document.getElementById('create-user-dialog').close()">Cancel</button>
                        <button class="button button-primary" type="submit">Create user</button>
                    </div>
                </form>
            </dialog>
        </section>

        <section class="panel">
            <h2>Existing accounts</h2>
            <div class="table-scroll">
                <table class="data-table user-table">
                    <thead><tr><th>USERNAME</th><th>NAME</th><th>ROLE</th><th>STATUS</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            var editDialogId = $"edit-user-{user.Id}";
                            var isEditing = Model.ShowEditUserId == user.Id;
                            <tr>
                                <td>@user.UserName</td>
                                <td>@user.DisplayName</td>
                                <td>@user.Roles</td>
                                <td>@(user.MustChangePassword ? "Password change required" : "Active")</td>
                                <td class="company-actions">
                                    <button class="button button-quiet button-small" type="button" onclick="document.getElementById('@editDialogId').showModal()">Edit</button>
                                    <dialog id="@editDialogId" class="modal-card modal-wide company-create-dialog" aria-labelledby="@editDialogId-heading">
                                        <div class="modal-heading">
                                            <div>
                                                <div class="panel-kicker">ACCOUNT DETAILS</div>
                                                <h2 id="@editDialogId-heading">Edit @user.UserName</h2>
                                                <p class="muted">Update profile information and company role.</p>
                                            </div>
                                            <button class="icon-button" type="button" aria-label="Close" onclick="document.getElementById('@editDialogId').close()">&times;</button>
                                        </div>
                                        @if (isEditing)
                                        {
                                            <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
                                        }
                                        <form method="post" asp-page-handler="Update" asp-route-id="@user.Id" class="company-create-form">
                                            <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                            <div class="company-modal-field"><label for="@editDialogId-username">Username</label><input id="@editDialogId-username" class="form-control" name="EditInput.UserName" value="@(isEditing ? Model.EditInput.UserName : user.UserName)" required maxlength="256" autocomplete="off" /></div>
                                            <div class="company-modal-field"><label for="@editDialogId-displayname">Display name</label><input id="@editDialogId-displayname" class="form-control" name="EditInput.DisplayName" value="@(isEditing ? Model.EditInput.DisplayName : user.DisplayName)" required maxlength="256" /></div>
                                            <div class="company-modal-field"><label for="@editDialogId-email">Email (optional)</label><input id="@editDialogId-email" class="form-control" name="EditInput.Email" type="email" value="@(isEditing ? Model.EditInput.Email : user.Email)" maxlength="256" autocomplete="email" /></div>
                                            <div class="company-modal-field">
                                                <label for="@editDialogId-role">Role</label>
                                                <select id="@editDialogId-role" class="form-control" name="EditInput.RoleId" required>
                                                    <option value="">Select a role</option>
                                                    @foreach (var role in Model.AvailableRoles)
                                                    {
                                                        <option value="@role.Id" selected="@((isEditing ? Model.EditInput.RoleId : user.RoleId) == role.Id ? "selected" : null)">@role.DisplayName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="modal-actions company-modal-actions">
                                                <button class="button button-quiet" type="button" onclick="document.getElementById('@editDialogId').close()">Cancel</button>
                                                <button class="button button-primary" type="submit">Save changes</button>
                                            </div>
                                        </form>
                                    </dialog>
                                </td>
                            </tr>
                        }
                        @if (Model.Users.Count == 0)
                        {
                            <tr><td colspan="5" class="company-empty-state">No users have been created for this company yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    @if (Model.ShowCreateDialog)
    {
        <script>
            document.getElementById('create-user-dialog').showModal();
        </script>
    }
    @if (Model.ShowEditUserId is not null)
    {
        <script>
            document.getElementById('edit-user-@Model.ShowEditUserId').showModal();
        </script>
    }
