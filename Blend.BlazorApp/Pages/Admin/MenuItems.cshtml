@page
@model MenuItemsModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Menu items · Blend Operations</title>
    <link rel="stylesheet" href="~/app.css" />
    <link rel="stylesheet" href="~/workspace.css" />
</head>
<body>
    <main class="content-area">
        <section class="panel">
            <div class="panel-kicker">ADMINISTRATION</div>
            <h1>Menu items</h1>
            <p>Create and order operation links and group related links in the left pane. Assign multiple menu items to each role from the Role management page.</p>
            <p><a class="button button-quiet" href="/" onclick="if (document.referrer && new URL(document.referrer).origin === location.origin) { history.back(); return false; }">&larr; Back</a> · <a href="/Admin/Roles">Role management</a></p>
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
            }
            @if (!Model.ShowCreateDialog && Model.ShowEditItemId is null && Model.ShowOperationsMenuItemId is null)
            {
                <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
            }
            @if (User.IsInRole(BlendRoles.Admin))
            {
                <form method="get" class="company-selector">
                    <label for="CompanyId">Company</label>
                    <select id="CompanyId" name="CompanyId" class="form-control" onchange="this.form.submit()">
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.Id" selected="@(Model.CompanyId == company.Id.ToString("D") ? "selected" : null)">@company.Name</option>
                        }
                    </select>
                </form>
            }
            <div class="user-list-heading">
                <div>
                    <h2>Menu catalog</h2>
                    <p>Manage operation links for @(Model.Companies.FirstOrDefault(company => company.Id.ToString("D") == Model.CompanyId)?.Name ?? "your company").</p>
                </div>
                <button class="button button-primary" type="button" onclick="document.getElementById('create-menu-item-dialog').showModal()" disabled="@(Model.CompanyId is null)">Create menu item</button>
            </div>
            <dialog id="create-menu-item-dialog" class="modal-card modal-wide company-create-dialog" aria-labelledby="create-menu-item-heading">
                <div class="modal-heading">
                    <div>
                        <div class="panel-kicker">NEW OPERATION LINK</div>
                        <h2 id="create-menu-item-heading">Create menu item</h2>
                        <p class="muted">Add a link to this company's navigation.</p>
                    </div>
                    <button class="icon-button" type="button" aria-label="Close" onclick="document.getElementById('create-menu-item-dialog').close()">&times;</button>
                </div>
                @if (Model.ShowCreateDialog)
                {
                    <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
                }
                <form method="post" asp-page-handler="Create" class="company-create-form">
                    <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                    <div class="company-modal-field"><label asp-for="Input.Name">Display name</label><input asp-for="Input.Name" class="form-control" required maxlength="100" /></div>
                    <div class="company-modal-field"><label asp-for="Input.GroupName">Group text</label><input asp-for="Input.GroupName" class="form-control" required maxlength="80" /></div>
                    <div class="company-modal-field"><label asp-for="Input.Path">Operation path</label><input asp-for="Input.Path" class="form-control" placeholder="/Operations/Planning" required maxlength="512" /></div>
                    <div class="company-modal-field"><label asp-for="Input.SortOrder">Sort order</label><input asp-for="Input.SortOrder" class="form-control" type="number" min="0" /></div>
                    <div class="modal-actions company-modal-actions">
                        <button class="button button-quiet" type="button" onclick="document.getElementById('create-menu-item-dialog').close()">Cancel</button>
                        <button class="button button-primary" type="submit">Create menu item</button>
                    </div>
                </form>
            </dialog>
        </section>

        <section class="panel">
            <h2>Existing menu items</h2>
            <div class="table-scroll">
                <table class="data-table menu-items-table">
                    <thead><tr><th>ITEM</th><th>GROUP</th><th>OPERATIONS</th><th>PATH</th><th>ORDER</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.MenuItems)
                        {
                            var editDialogId = $"edit-menu-item-{item.Id}";
                            var operationsDialogId = $"menu-item-operations-{item.Id}";
                            var isEditing = Model.ShowEditItemId == item.Id;
                            var isManagingOperations = Model.ShowOperationsMenuItemId == item.Id;
                            var operations = Model.OperationsByMenuItem.TryGetValue(item.Id, out var itemOperations) ? itemOperations : [];
                            <tr>
                                <td class="menu-item-summary"><strong>@item.Name</strong></td>
                                <td>@item.GroupName</td>
                                <td class="menu-operation-summary">@string.Join(", ", operations.Select(operation => operation.Name))</td>
                                <td class="menu-item-path">@item.Path</td>
                                <td>@item.SortOrder</td>
                                <td class="company-actions">
                                    <div class="menu-item-actions">
                                        <button class="button button-quiet button-small" type="button" onclick="document.getElementById('@editDialogId').showModal()">Edit</button>
                                        <button class="button button-quiet button-small" type="button" onclick="document.getElementById('@operationsDialogId').showModal()">Operations</button>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Delete this menu item and its operation assignments?');">
                                            <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                            <button class="button button-danger-quiet button-small" type="submit">Delete</button>
                                        </form>
                                    </div>
                                    <dialog id="@operationsDialogId" class="modal-card modal-wide company-create-dialog" aria-labelledby="@operationsDialogId-heading">
                                        <div class="modal-heading">
                                            <div>
                                                <div class="panel-kicker">OPERATION PERMISSIONS</div>
                                                <h2 id="@operationsDialogId-heading">@item.Name operations</h2>
                                                <p class="muted">Define actions for this module; roles can be granted each action from Role management.</p>
                                            </div>
                                            <button class="icon-button" type="button" aria-label="Close" onclick="document.getElementById('@operationsDialogId').close()">&times;</button>
                                        </div>
                                        @if (isManagingOperations)
                                        {
                                            <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
                                        }
                                        <div class="operation-list">
                                            @foreach (var operation in operations)
                                            {
                                                <div class="operation-row">
                                                    <span><strong>@operation.Name</strong><small>@operation.Key</small></span>
                                                    <form method="post" asp-page-handler="DeleteOperation" asp-route-id="@item.Id" asp-route-operationId="@operation.Id" onsubmit="return confirm('Remove this operation and its grants from all roles?');">
                                                        <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                                        <button class="button button-danger-quiet button-small" type="submit">Remove</button>
                                                    </form>
                                                </div>
                                            }
                                            @if (operations.Count == 0)
                                            {
                                                <p class="muted">No operations defined yet.</p>
                                            }
                                        </div>
                                        <form method="post" asp-page-handler="AddOperation" asp-route-id="@item.Id" class="operation-add-form">
                                            <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                            <div class="company-modal-field"><label for="@operationsDialogId-name">Add custom operation</label><input id="@operationsDialogId-name" class="form-control" name="OperationInput.Name" value="@(isManagingOperations ? Model.OperationInput.Name : string.Empty)" placeholder="Approve, Close, Export..." maxlength="80" required /></div>
                                            <div class="modal-actions company-modal-actions">
                                                <button class="button button-quiet" type="button" onclick="document.getElementById('@operationsDialogId').close()">Done</button>
                                                <button class="button button-primary" type="submit">Add operation</button>
                                            </div>
                                        </form>
                                    </dialog>
                                    <dialog id="@editDialogId" class="modal-card modal-wide company-create-dialog" aria-labelledby="@editDialogId-heading">
                                        <div class="modal-heading">
                                            <div>
                                                <div class="panel-kicker">OPERATION LINK</div>
                                                <h2 id="@editDialogId-heading">Edit @item.Name</h2>
                                                <p class="muted">Update this navigation item and its destination.</p>
                                            </div>
                                            <button class="icon-button" type="button" aria-label="Close" onclick="document.getElementById('@editDialogId').close()">&times;</button>
                                        </div>
                                        @if (isEditing)
                                        {
                                            <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
                                        }
                                        <form method="post" asp-page-handler="Update" asp-route-id="@item.Id" class="company-create-form">
                                            <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                            <div class="company-modal-field"><label for="@editDialogId-name">Display name</label><input id="@editDialogId-name" class="form-control" name="Input.Name" value="@(isEditing ? Model.Input.Name : item.Name)" required maxlength="100" /></div>
                                            <div class="company-modal-field"><label for="@editDialogId-group">Group text</label><input id="@editDialogId-group" class="form-control" name="Input.GroupName" value="@(isEditing ? Model.Input.GroupName : item.GroupName)" required maxlength="80" /></div>
                                            <div class="company-modal-field"><label for="@editDialogId-path">Operation path</label><input id="@editDialogId-path" class="form-control" name="Input.Path" value="@(isEditing ? Model.Input.Path : item.Path)" placeholder="/Operations/Planning" required maxlength="512" /></div>
                                            <div class="company-modal-field"><label for="@editDialogId-order">Sort order</label><input id="@editDialogId-order" class="form-control" name="Input.SortOrder" type="number" value="@(isEditing ? Model.Input.SortOrder : item.SortOrder)" min="0" /></div>
                                            <div class="modal-actions company-modal-actions">
                                                <button class="button button-quiet" type="button" onclick="document.getElementById('@editDialogId').close()">Cancel</button>
                                                <button class="button button-primary" type="submit">Save changes</button>
                                            </div>
                                        </form>
                                    </dialog>
                                </td>
                            </tr>
                        }
                        @if (Model.MenuItems.Count == 0)
                        {
                            <tr><td colspan="5" class="company-empty-state">No menu items have been created for this company yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    @if (Model.ShowCreateDialog)
    {
        <script>
            document.getElementById('create-menu-item-dialog').showModal();
        </script>
    }
    @if (Model.ShowEditItemId is not null)
    {
        <script>
            document.getElementById('edit-menu-item-@Model.ShowEditItemId').showModal();
        </script>
    }
</body>
</html>
