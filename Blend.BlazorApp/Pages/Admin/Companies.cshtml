@page
@model CompaniesModel
@{
    Layout = null;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Companies · Blend Operations</title>
    <link rel="stylesheet" href="~/app.css" />
    <link rel="stylesheet" href="~/workspace.css" />
</head>
<body>
    <main class="content-area">
        <section class="panel">
            <div class="panel-kicker">PLATFORM ADMINISTRATION</div>
            <h1>Companies</h1>
            <p>Create companies, maintain their contact details, and manage subscription access windows. Expired, future, or disabled subscriptions block company users.</p>
            <p><a class="button button-quiet" href="/" onclick="if (document.referrer && new URL(document.referrer).origin === location.origin) { history.back(); return false; }">&larr; Back</a></p>
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
            }
            <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
            <h2>Create company</h2>
            <form method="post" asp-page-handler="Create" class="company-edit-form">
                <label asp-for="Input.Name">Company name</label><input asp-for="Input.Name" class="form-control" required maxlength="160" />
                <label asp-for="Input.AddressLine1">Address line 1</label><input asp-for="Input.AddressLine1" class="form-control" maxlength="200" />
                <label asp-for="Input.AddressLine2">Address line 2</label><input asp-for="Input.AddressLine2" class="form-control" maxlength="200" />
                <label asp-for="Input.City">City</label><input asp-for="Input.City" class="form-control" maxlength="100" />
                <label asp-for="Input.Region">State / region</label><input asp-for="Input.Region" class="form-control" maxlength="100" />
                <label asp-for="Input.PostalCode">Postal code</label><input asp-for="Input.PostalCode" class="form-control" maxlength="30" />
                <label asp-for="Input.Country">Country</label><input asp-for="Input.Country" class="form-control" maxlength="100" />
                <label asp-for="Input.SubscriptionStartDate">Subscription starts (UTC date)</label><input asp-for="Input.SubscriptionStartDate" class="form-control" type="date" required />
                <label asp-for="Input.SubscriptionEndDate">Subscription ends (UTC date, inclusive)</label><input asp-for="Input.SubscriptionEndDate" class="form-control" type="date" required />
                <label class="company-enabled"><input asp-for="Input.IsEnabled" /> Enabled</label>
                <button class="button button-primary" type="submit">Create company</button>
            </form>
        </section>

        <section class="panel">
            <h2>Company accounts</h2>
            <div class="table-scroll">
                <table class="data-table company-table">
                    <thead><tr><th>COMPANY</th><th>ADDRESS</th><th>SUBSCRIPTION</th><th>STATUS</th><th>SAVE</th></tr></thead>
                    <tbody>
                        @foreach (var company in Model.Companies)
                        {
                            var formId = $"update-company-{company.Id:N}";
                            var active = company.IsEnabled && today >= company.SubscriptionStartDate && today <= company.SubscriptionEndDate;
                            <tr>
                                <td>
                                    <input form="@formId" class="form-control" name="Input.Name" value="@company.Name" required maxlength="160" aria-label="Company name" />
                                    <input form="@formId" class="form-control company-address-second" name="Input.AddressLine1" value="@company.AddressLine1" maxlength="200" aria-label="Address line 1" placeholder="Address line 1" />
                                    <input form="@formId" class="form-control company-address-second" name="Input.AddressLine2" value="@company.AddressLine2" maxlength="200" aria-label="Address line 2" placeholder="Address line 2" />
                                </td>
                                <td>
                                    <input form="@formId" class="form-control" name="Input.City" value="@company.City" maxlength="100" aria-label="City" placeholder="City" />
                                    <input form="@formId" class="form-control company-address-second" name="Input.Region" value="@company.Region" maxlength="100" aria-label="State or region" placeholder="State / region" />
                                    <input form="@formId" class="form-control company-address-second" name="Input.PostalCode" value="@company.PostalCode" maxlength="30" aria-label="Postal code" placeholder="Postal code" />
                                    <input form="@formId" class="form-control company-address-second" name="Input.Country" value="@company.Country" maxlength="100" aria-label="Country" placeholder="Country" />
                                </td>
                                <td>
                                    <label>Start <input form="@formId" class="form-control company-date" name="Input.SubscriptionStartDate" type="date" value="@company.SubscriptionStartDate.ToString("yyyy-MM-dd")" required /></label>
                                    <label>End <input form="@formId" class="form-control company-date" name="Input.SubscriptionEndDate" type="date" value="@company.SubscriptionEndDate.ToString("yyyy-MM-dd")" required /></label>
                                </td>
                                <td>
                                    <span class="blend-chip">@(active ? "Active" : company.IsEnabled ? "Out of term" : "Disabled")</span>
                                    <label class="company-enabled"><input form="@formId" type="checkbox" name="Input.IsEnabled" value="true" checked="@(company.IsEnabled ? "checked" : null)" /> Enabled</label>
                                    <input form="@formId" type="hidden" name="Input.IsEnabled" value="false" />
                                </td>
                                <td>
                                    <form id="@formId" method="post" asp-page-handler="Update" asp-route-id="@company.Id">
                                        <button class="button button-primary button-small" type="submit">Save</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (Model.Companies.Count == 0)
                        {
                            <tr><td colspan="5">No companies have been created.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>
</html>
