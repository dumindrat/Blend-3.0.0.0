@page
@model CompaniesModel
@{
    Layout = "_Layout";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}
<main class="content-area">
        <section class="panel">
            <div class="panel-kicker">PLATFORM ADMINISTRATION</div>
            <h1>Companies</h1>
            <div class="company-list-heading">
                <div>
                    <p>Create companies, maintain their contact details, and manage subscription access windows. Expired, future, or disabled subscriptions block company users.</p>
                    <a class="button button-quiet" href="/" onclick="if (document.referrer && new URL(document.referrer).origin === location.origin) { history.back(); return false; }">&larr; Back</a>
                </div>
                <button class="button button-primary" type="button" onclick="document.getElementById('create-company-dialog').showModal()">Create company</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
            }
            @if (!Model.ShowCreateDialog)
            {
                <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
            }
            <dialog id="create-company-dialog" class="modal-card modal-wide company-create-dialog" aria-labelledby="create-company-heading">
                <div class="modal-heading">
                    <div>
                        <div class="panel-kicker">NEW COMPANY</div>
                        <h2 id="create-company-heading">Create company</h2>
                        <p class="muted">Add company details and set its subscription period.</p>
                    </div>
                    <button class="icon-button" type="button" aria-label="Close" onclick="document.getElementById('create-company-dialog').close()">&times;</button>
                </div>
                <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
                <form method="post" asp-page-handler="Create" class="company-create-form">
                    <div class="company-modal-field"><label asp-for="Input.Name">Company name</label><input asp-for="Input.Name" class="form-control" required maxlength="160" /></div>
                    <div class="company-modal-field"><label asp-for="Input.AddressLine1">Address line 1</label><input asp-for="Input.AddressLine1" class="form-control" maxlength="200" /></div>
                    <div class="company-modal-field"><label asp-for="Input.AddressLine2">Address line 2</label><input asp-for="Input.AddressLine2" class="form-control" maxlength="200" /></div>
                    <div class="company-modal-field"><label asp-for="Input.City">City</label><input asp-for="Input.City" class="form-control" maxlength="100" /></div>
                    <div class="company-modal-field"><label asp-for="Input.Region">State / region</label><input asp-for="Input.Region" class="form-control" maxlength="100" /></div>
                    <div class="company-modal-field"><label asp-for="Input.PostalCode">Postal code</label><input asp-for="Input.PostalCode" class="form-control" maxlength="30" /></div>
                    <div class="company-modal-field"><label asp-for="Input.Country">Country</label><input asp-for="Input.Country" class="form-control" maxlength="100" /></div>
                    <div class="company-modal-field"><label asp-for="Input.SubscriptionStartDate">Subscription starts (UTC date)</label><input asp-for="Input.SubscriptionStartDate" class="form-control" type="date" required /></div>
                    <div class="company-modal-field"><label asp-for="Input.SubscriptionEndDate">Subscription ends (UTC date, inclusive)</label><input asp-for="Input.SubscriptionEndDate" class="form-control" type="date" required /></div>
                    <label class="company-enabled company-modal-enabled"><input asp-for="Input.IsEnabled" /> Enabled</label>
                    <div class="modal-actions company-modal-actions">
                        <button class="button button-quiet" type="button" onclick="document.getElementById('create-company-dialog').close()">Cancel</button>
                        <button class="button button-primary" type="submit">Create company</button>
                    </div>
                </form>
            </dialog>
        </section>

        <section class="panel">
            <h2>Companies</h2>
            <div class="table-scroll">
                <table class="data-table company-table">
                    <thead><tr><th>COMPANY</th><th>SUBSCRIPTION PERIOD</th><th>STATUS</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var company in Model.Companies)
                        {
                            var active = company.IsEnabled && today >= company.SubscriptionStartDate && today <= company.SubscriptionEndDate;
                            var address = string.Join(", ", new[] { company.AddressLine1, company.AddressLine2, company.City, company.Region, company.PostalCode, company.Country }.Where(value => !string.IsNullOrWhiteSpace(value)));
                            var dialogId = $"edit-company-{company.Id:N}";
                            <tr>
                                <td class="company-summary">
                                    <strong>@company.Name</strong>
                                    <span>Company mapping ID: @company.CompanyNumber</span>
                                    <span>@(string.IsNullOrWhiteSpace(address) ? "No address provided" : address)</span>
                                </td>
                                <td class="company-subscription">
                                    <span>@company.SubscriptionStartDate.ToString("MMM d, yyyy")</span>
                                    <span>to @company.SubscriptionEndDate.ToString("MMM d, yyyy")</span>
                                </td>
                                <td><span class="company-status @(active ? "company-status-active" : company.IsEnabled ? "company-status-pending" : "company-status-disabled")">@(active ? "Active" : company.IsEnabled ? "Out of term" : "Disabled")</span></td>
                                <td class="company-actions">
                                    <button class="button button-quiet button-small" type="button" onclick="document.getElementById('@dialogId').showModal()">Edit</button>
                                    <dialog id="@dialogId" class="modal-card modal-wide company-create-dialog" aria-labelledby="@dialogId-heading">
                                        <div class="modal-heading">
                                            <div>
                                                <div class="panel-kicker">COMPANY DETAILS</div>
                                                <h2 id="@dialogId-heading">Edit @company.Name</h2>
                                                <p class="muted">Update contact information and subscription access.</p>
                                            </div>
                                            <button class="icon-button" type="button" aria-label="Close" onclick="document.getElementById('@dialogId').close()">&times;</button>
                                        </div>
                                        <form method="post" asp-page-handler="Update" asp-route-id="@company.Id" class="company-create-form">
                                            <div class="company-modal-field"><label>Company name</label><input class="form-control" name="Input.Name" value="@company.Name" required maxlength="160" /></div>
                                            <div class="company-modal-field"><label>Address line 1</label><input class="form-control" name="Input.AddressLine1" value="@company.AddressLine1" maxlength="200" /></div>
                                            <div class="company-modal-field"><label>Address line 2</label><input class="form-control" name="Input.AddressLine2" value="@company.AddressLine2" maxlength="200" /></div>
                                            <div class="company-modal-field"><label>City</label><input class="form-control" name="Input.City" value="@company.City" maxlength="100" /></div>
                                            <div class="company-modal-field"><label>State / region</label><input class="form-control" name="Input.Region" value="@company.Region" maxlength="100" /></div>
                                            <div class="company-modal-field"><label>Postal code</label><input class="form-control" name="Input.PostalCode" value="@company.PostalCode" maxlength="30" /></div>
                                            <div class="company-modal-field"><label>Country</label><input class="form-control" name="Input.Country" value="@company.Country" maxlength="100" /></div>
                                            <div class="company-modal-field"><label>Subscription starts (UTC date)</label><input class="form-control" name="Input.SubscriptionStartDate" type="date" value="@company.SubscriptionStartDate.ToString("yyyy-MM-dd")" required /></div>
                                            <div class="company-modal-field"><label>Subscription ends (UTC date, inclusive)</label><input class="form-control" name="Input.SubscriptionEndDate" type="date" value="@company.SubscriptionEndDate.ToString("yyyy-MM-dd")" required /></div>
                                            <label class="company-enabled company-modal-enabled"><input type="checkbox" name="Input.IsEnabled" value="true" checked="@(company.IsEnabled ? "checked" : null)" /> Enabled</label>
                                            <input type="hidden" name="Input.IsEnabled" value="false" />
                                            <div class="modal-actions company-modal-actions">
                                                <button class="button button-quiet" type="button" onclick="document.getElementById('@dialogId').close()">Cancel</button>
                                                <button class="button button-primary" type="submit">Save changes</button>
                                            </div>
                                        </form>
                                    </dialog>
                                </td>
                            </tr>
                        }
                        @if (Model.Companies.Count == 0)
                        {
                            <tr><td colspan="4" class="company-empty-state">No companies have been created yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    @if (Model.ShowCreateDialog)
    {
        <script>
            document.getElementById('create-company-dialog').showModal();
        </script>
    }
