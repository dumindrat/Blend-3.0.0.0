@page
@model RolesModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Role management · Blend Operations</title>
    <link rel="stylesheet" href="~/app.css" />
    <link rel="stylesheet" href="~/workspace.css" />
</head>
<body>
    <main class="content-area">
        <section class="panel">
            <div class="panel-kicker">ADMINISTRATION</div>
            <h1>Roles</h1>
            <p>Create roles, choose their permissions, and assign each role access to multiple operations. Built-in roles cannot be renamed.</p>
            <p><a class="button button-quiet" href="/" onclick="if (document.referrer && new URL(document.referrer).origin === location.origin) { history.back(); return false; }">&larr; Back</a> · <a href="/Admin/Users">Manage users</a></p>
            <form method="get" class="company-selector">
                <label for="CompanyId">Company</label>
                <select id="CompanyId" name="CompanyId" class="form-control" onchange="this.form.submit()">
                    @foreach (var company in Model.Companies)
                    {
                        <option value="@company.Id" selected="@(Model.CompanyId == company.Id.ToString("D") ? "selected" : null)">@company.Name</option>
                    }
                </select>
            </form>
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
            }
            <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
            <h2>Create role</h2>
            <form method="post" asp-page-handler="Create">
                <input type="hidden" asp-for="Input.CompanyId" value="@Model.CompanyId" />
                <label asp-for="Input.Name">Role name</label>
                <input asp-for="Input.Name" class="form-control" required maxlength="100" />
                <label><input asp-for="Input.CanManageUsers" /> Manage users</label>
                <label><input asp-for="Input.CanManageRoles" /> Manage roles</label>
                <label><input asp-for="Input.CanManageMenuItems" /> Manage menu items</label>
                <button class="button button-primary" type="submit" disabled="@(Model.CompanyId is null)">Create role</button>
            </form>
        </section>

        <section class="panel">
            <h2>Existing roles</h2>
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>ROLE</th><th>PERMISSIONS</th><th>ASSIGNED MENU ITEMS</th><th>ACTIONS</th></tr></thead>
                    <tbody>
                        @foreach (var role in Model.Roles)
                        {
                            var assignmentFormId = $"assign-menu-items-{role.Id}";
                            var assignedMenuItemIds = Model.AssignedMenuItemIds.TryGetValue(role.Id, out var itemIds) ? itemIds : new HashSet<int>();
                            <tr>
                                @if (role.IsSystemRole)
                                {
                                    <td><strong>@role.Name</strong> <span>(built-in)</span></td>
                                    <td>@(role.CanManageUsers ? "Manage users" : "No administrative permissions")<br />@(role.CanManageRoles ? "Manage roles" : string.Empty)<br />@(role.CanManageMenuItems ? "Manage menu items" : string.Empty)</td>
                                    <td>
                                        <form id="@assignmentFormId" method="post" asp-page-handler="AssignMenuItems">
                                            <input type="hidden" name="MenuAssignment.RoleId" value="@role.Id" />
                                            <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                        </form>
                                        <div class="role-menu-options">
                                            @foreach (var item in Model.MenuItems)
                                            {
                                                <label><input form="@assignmentFormId" type="checkbox" name="MenuAssignment.MenuItemIds" value="@item.Id" checked="@(assignedMenuItemIds.Contains(item.Id) ? "checked" : null)" /> @item.Name</label>
                                            }
                                        </div>
                                    </td>
                                    <td><button class="button button-primary button-small" type="submit" form="@assignmentFormId">Save menu items</button></td>
                                }
                                else
                                {
                                    var updateFormId = $"update-role-{role.Id}";
                                    <td><input form="@updateFormId" class="form-control role-name-input" name="Input.Name" value="@role.Name" required maxlength="100" aria-label="Role name" /></td>
                                    <td>
                                        <label><input form="@updateFormId" type="checkbox" name="Input.CanManageUsers" value="true" checked="@(role.CanManageUsers ? "checked" : null)" /> Manage users</label>
                                        <input form="@updateFormId" type="hidden" name="Input.CanManageUsers" value="false" />
                                        <label><input form="@updateFormId" type="checkbox" name="Input.CanManageRoles" value="true" checked="@(role.CanManageRoles ? "checked" : null)" /> Manage roles</label>
                                        <input form="@updateFormId" type="hidden" name="Input.CanManageRoles" value="false" />
                                        <label><input form="@updateFormId" type="checkbox" name="Input.CanManageMenuItems" value="true" checked="@(role.CanManageMenuItems ? "checked" : null)" /> Manage menu items</label>
                                        <input form="@updateFormId" type="hidden" name="Input.CanManageMenuItems" value="false" />
                                    </td>
                                    <td>
                                        <form id="@assignmentFormId" method="post" asp-page-handler="AssignMenuItems">
                                            <input type="hidden" name="MenuAssignment.RoleId" value="@role.Id" />
                                            <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
                                        </form>
                                        <div class="role-menu-options">
                                            @foreach (var item in Model.MenuItems)
                                            {
                                                <label><input form="@assignmentFormId" type="checkbox" name="MenuAssignment.MenuItemIds" value="@item.Id" checked="@(assignedMenuItemIds.Contains(item.Id) ? "checked" : null)" /> @item.Name <small>@item.GroupName</small></label>
                                            }
                                        </div>
                                    </td>
                                    <td class="role-menu-actions">
                                        <form id="@updateFormId" method="post" asp-page-handler="Update">
                                            <input type="hidden" name="Input.Id" value="@role.Id" />
                                            <input type="hidden" name="Input.CompanyId" value="@Model.CompanyId" />
                                            <button class="button button-primary button-small" type="submit">Save role</button>
                                        </form>
                                        <button class="button button-quiet button-small" type="submit" form="@assignmentFormId">Save menu items</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>
</html>
